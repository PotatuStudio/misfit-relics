{
 "model": {
  "type": "minecraft:select",
  "property": "minecraft:display_context",
  "cases": [
   {
    "when": [
     "gui",
     "ground",
     "fixed"
    ],
    "model": {
     "type": "minecraft:model",
     "model": "misfitrelics:item/exposed_spud_cannon_icon"
    }
   }
  ],
  "fallback": {
   "type": "minecraft:condition",
   "property": "minecraft:using_item",
   "on_false": {
    "type": "minecraft:model",
    "model": "misfitrelics:item/exposed_spud_cannon"
   },
   "on_true": {
    "type": "minecraft:range_dispatch",
    "property": "minecraft:use_duration",
    "scale": 0.1,
    "entries": [
     {
      "threshold": 1.0,
      "model": {
       "type": "minecraft:model",
       "model": "misfitrelics:item/exposed_spud_cannon_charged"
      }
     }
    ],
    "fallback": {
     "type": "minecraft:model",
     "model": "misfitrelics:item/exposed_spud_cannon"
    }
   }
  }
 }
}
